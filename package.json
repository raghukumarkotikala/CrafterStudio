{
  "name": "crafter-studio",
  "productName": "Crafter Studio",
  "desktopName": "crafter-studio.desktop",
  "version": "1.3.0",
  "description": "Crafter Studio - laser engraving & cutting design and control studio",
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0",
    "npm": "<11"
  },
  "scripts": {
    "start": "electron .",
    "library": "node scripts/build-library.js",
    "guide": "node --no-warnings scripts/build-guide.mjs",
    "dist": "npm run library && npm run guide && electron-builder --win --x64",
    "dist:linux": "npm run library && npm run guide && electron-builder --linux AppImage --x64",
    "dist:all": "npm run library && npm run guide && electron-builder --win --linux --x64",
    "dist:dir": "electron-builder --dir"
  },
  "author": "Crafter Studio",
  "homepage": "https://crafterstudio.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raghukumarkotikala/CrafterStudio.git"
  },
  "bugs": {
    "url": "https://github.com/raghukumarkotikala/CrafterStudio/issues"
  },
  "license": "ISC",
  "dependencies": {
    "dxf-parser": "^1.1.2",
    "imagetracerjs": "^1.2.6",
    "opentype.js": "^2.0.0",
    "paper": "^0.12.18",
    "paperjs-offset": "^2.2.1"
  },
  "devDependencies": {
    "@mdi/svg": "^7.4.47",
    "@tabler/icons": "^3.47.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "in.crafterstudio.app",
    "productName": "Crafter Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CrafterStudio-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "CrafterStudio-Portable-${version}.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Graphics",
      "syncDesktopName": true,
      "artifactName": "CrafterStudio-${version}-x86_64.AppImage"
    }
  }
}
