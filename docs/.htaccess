# Crafter Studio — static site (Apache / cPanel)

Options -Indexes
DirectoryIndex index.html

# --- Force HTTPS -------------------------------------------------------------
# Leave this commented until cPanel's AutoSSL has issued a certificate for the
# domain. Enabling it first sends visitors to an https:// URL that does not yet
# work. Once the padlock appears in cPanel > SSL/TLS Status, uncomment it.
#
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteCond %{HTTP:X-Forwarded-Proto} !https
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# </IfModule>

# --- Compression -------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript image/svg+xml
</IfModule>

# --- Caching -----------------------------------------------------------------
# Images are fingerprint-free, so keep their lifetime modest; if you replace
# screenshot.png or wordmark.png, visitors pick it up within a week.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png        "access plus 7 days"
  ExpiresByType image/x-icon     "access plus 7 days"
  ExpiresByType text/css         "access plus 7 days"
  ExpiresByType text/html        "access plus 10 minutes"
  ExpiresDefault                 "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
